{
  "name": "cutline",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "dev": "concurrently -n api,web,mobile -c blue,green,magenta \"npm run dev -w @cutline/api\" \"npm run dev -w @cutline/web\" \"npm run dev -w @cutline/mobile\"",
    "dev:api": "npm run dev -w @cutline/api",
    "dev:web": "npm run dev -w @cutline/web",
    "dev:mobile": "npm run dev -w @cutline/mobile",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @cutline/shared && npm run build -w @cutline/api && npm run build -w @cutline/web",
    "db:migrate": "npm run db:migrate -w @cutline/api"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.0.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
